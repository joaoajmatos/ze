{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ze UI Primitives",
  "$defs": {
    "ClaimPosture": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "identity",
            "fact",
            "inference",
            "suspicion",
            "priority",
            "action_record",
            "feedback_record"
          ]
        },
        "subject": {
          "enum": [
            "loop",
            "goal",
            "workflow",
            "hypothesis",
            "person",
            "held_write",
            "fact"
          ]
        },
        "ref_id": {
          "type": "string"
        },
        "confidence": {
          "type": "number"
        },
        "confidence_from": {
          "type": "number"
        },
        "source": {
          "type": "string"
        },
        "as_of": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "slipped": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "subject",
        "ref_id"
      ]
    },
    "Readout": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "tone": {
          "enum": [
            "default",
            "live",
            "hot"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "label",
        "value"
      ]
    },
    "CardAction": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "intent": {
          "enum": [
            "confirm_loop",
            "drop_loop",
            "approve_held_write",
            "deny_held_write",
            "approve_gate",
            "open"
          ]
        },
        "ref_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "label",
        "intent",
        "ref_id"
      ]
    },
    "TimelineEntry": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "claim": {
          "$ref": "#/$defs/ClaimPosture"
        },
        "due_at": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "title",
        "claim"
      ]
    },
    "FormField": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "field_type": {
          "enum": [
            "text",
            "textarea",
            "number",
            "date",
            "select",
            "multiselect",
            "boolean",
            "chips"
          ]
        },
        "placeholder": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required": {
          "type": "boolean"
        },
        "help_text": {
          "type": "string"
        },
        "default_value": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ]
    },
    "ConnectionEvidence": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "label",
        "kind"
      ]
    },
    "ConnectionItem": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string"
        },
        "narrative": {
          "type": "string"
        },
        "relation": {
          "type": "string"
        },
        "confidence": {
          "type": "number"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConnectionEvidence"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "summary",
        "narrative",
        "relation",
        "confidence"
      ]
    },
    "StepItem": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "label",
        "status"
      ]
    },
    "ChartPoint": {
      "type": "object",
      "properties": {
        "x": {
          "type": "string"
        },
        "y": {
          "type": "number"
        },
        "series": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ]
    },
    "FacetFact": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "claim": {
          "$ref": "#/$defs/ClaimPosture"
        },
        "source": {
          "type": "string"
        },
        "at": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "text",
        "claim"
      ]
    },
    "Stat": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "delta": {
          "type": "string"
        },
        "direction": {
          "enum": [
            "up",
            "down",
            "flat"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "label",
        "value"
      ]
    },
    "ClaimItem": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "claim": {
          "$ref": "#/$defs/ClaimPosture"
        },
        "action": {
          "$ref": "#/$defs/PrimitiveAction"
        }
      },
      "additionalProperties": false,
      "required": [
        "text",
        "claim"
      ]
    },
    "RowAction": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "action": {
          "$ref": "#/$defs/PrimitiveAction"
        }
      },
      "additionalProperties": false,
      "required": [
        "label",
        "action"
      ]
    },
    "AskAction": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "kind": {
          "const": "ask"
        }
      },
      "additionalProperties": false,
      "required": [
        "text",
        "kind"
      ]
    },
    "ToolAction": {
      "type": "object",
      "properties": {
        "owner": {
          "type": "string",
          "maxLength": 64
        },
        "tool": {
          "type": "string",
          "maxLength": 64
        },
        "args": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ],
            "maxLength": 200
          },
          "maxProperties": 12,
          "propertyNames": {
            "maxLength": 64
          }
        },
        "kind": {
          "const": "tool"
        }
      },
      "additionalProperties": false,
      "required": [
        "owner",
        "tool",
        "args",
        "kind"
      ]
    },
    "NavigateAction": {
      "type": "object",
      "properties": {
        "route": {
          "type": "string",
          "pattern": "^/(?!/)(?!.*\\.\\.)"
        },
        "kind": {
          "const": "navigate"
        }
      },
      "additionalProperties": false,
      "required": [
        "route",
        "kind"
      ]
    },
    "ComposeAction": {
      "type": "object",
      "properties": {
        "compose": {
          "enum": [
            "slipping",
            "decisions",
            "topic"
          ]
        },
        "topic": {
          "type": "string",
          "maxLength": 120
        },
        "kind": {
          "const": "compose"
        }
      },
      "additionalProperties": false,
      "required": [
        "compose",
        "kind"
      ]
    },
    "PrimitiveAction": {
      "oneOf": [
        {
          "$ref": "#/$defs/AskAction"
        },
        {
          "$ref": "#/$defs/ToolAction"
        },
        {
          "$ref": "#/$defs/NavigateAction"
        },
        {
          "$ref": "#/$defs/ComposeAction"
        }
      ],
      "discriminator": {
        "propertyName": "kind",
        "mapping": {
          "ask": "#/$defs/AskAction",
          "tool": "#/$defs/ToolAction",
          "navigate": "#/$defs/NavigateAction",
          "compose": "#/$defs/ComposeAction"
        }
      }
    },
    "Col": {
      "type": "object",
      "properties": {
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Primitive"
          }
        },
        "gap": {
          "enum": [
            "none",
            "sm",
            "md",
            "lg"
          ]
        },
        "variant": {
          "enum": [
            "default",
            "card",
            "section"
          ]
        },
        "claim": {
          "$ref": "#/$defs/ClaimPosture"
        },
        "type": {
          "const": "col"
        }
      },
      "additionalProperties": false,
      "required": [
        "children",
        "type"
      ]
    },
    "Row": {
      "type": "object",
      "properties": {
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Primitive"
          }
        },
        "gap": {
          "enum": [
            "none",
            "sm",
            "md",
            "lg"
          ]
        },
        "align": {
          "enum": [
            "start",
            "center",
            "end",
            "between"
          ]
        },
        "claim": {
          "$ref": "#/$defs/ClaimPosture"
        },
        "type": {
          "const": "row"
        }
      },
      "additionalProperties": false,
      "required": [
        "children",
        "type"
      ]
    },
    "Text": {
      "type": "object",
      "properties": {
        "content": {
          "type": "string"
        },
        "style": {
          "enum": [
            "heading",
            "subheading",
            "body",
            "label",
            "caption",
            "code"
          ]
        },
        "color": {
          "enum": [
            "default",
            "muted",
            "success",
            "warning",
            "error"
          ]
        },
        "claim": {
          "$ref": "#/$defs/ClaimPosture"
        },
        "type": {
          "const": "text"
        }
      },
      "additionalProperties": false,
      "required": [
        "content",
        "type"
      ]
    },
    "Badge": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "color": {
          "enum": [
            "default",
            "success",
            "warning",
            "error",
            "info"
          ]
        },
        "claim": {
          "$ref": "#/$defs/ClaimPosture"
        },
        "type": {
          "const": "badge"
        }
      },
      "additionalProperties": false,
      "required": [
        "label",
        "type"
      ]
    },
    "Divider": {
      "type": "object",
      "properties": {
        "claim": {
          "$ref": "#/$defs/ClaimPosture"
        },
        "type": {
          "const": "divider"
        }
      },
      "additionalProperties": false,
      "required": [
        "type"
      ]
    },
    "Spacer": {
      "type": "object",
      "properties": {
        "size": {
          "enum": [
            "sm",
            "md",
            "lg"
          ]
        },
        "claim": {
          "$ref": "#/$defs/ClaimPosture"
        },
        "type": {
          "const": "spacer"
        }
      },
      "additionalProperties": false,
      "required": [
        "type"
      ]
    },
    "Button": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "action": {
          "$ref": "#/$defs/PrimitiveAction"
        },
        "style": {
          "enum": [
            "primary",
            "secondary",
            "danger"
          ]
        },
        "claim": {
          "$ref": "#/$defs/ClaimPosture"
        },
        "type": {
          "const": "button"
        }
      },
      "additionalProperties": false,
      "required": [
        "label",
        "action",
        "type"
      ]
    },
    "Table": {
      "type": "object",
      "properties": {
        "headers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "title": {
          "type": "string"
        },
        "caption": {
          "type": "string"
        },
        "keys": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "row_actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RowAction"
          }
        },
        "claim": {
          "$ref": "#/$defs/ClaimPosture"
        },
        "type": {
          "const": "table"
        }
      },
      "additionalProperties": false,
      "required": [
        "headers",
        "rows",
        "type"
      ]
    },
    "Form": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FormField"
          }
        },
        "claim": {
          "$ref": "#/$defs/ClaimPosture"
        },
        "type": {
          "const": "form"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "fields",
        "type"
      ]
    },
    "Connections": {
      "type": "object",
      "properties": {
        "connections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConnectionItem"
          }
        },
        "title": {
          "type": "string"
        },
        "claim": {
          "$ref": "#/$defs/ClaimPosture"
        },
        "type": {
          "const": "connections"
        }
      },
      "additionalProperties": false,
      "required": [
        "connections",
        "type"
      ]
    },
    "Steps": {
      "type": "object",
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StepItem"
          }
        },
        "title": {
          "type": "string"
        },
        "claim": {
          "$ref": "#/$defs/ClaimPosture"
        },
        "type": {
          "const": "steps"
        }
      },
      "additionalProperties": false,
      "required": [
        "steps",
        "type"
      ]
    },
    "Chart": {
      "type": "object",
      "properties": {
        "chart_type": {
          "enum": [
            "line",
            "bar",
            "area",
            "pie"
          ]
        },
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChartPoint"
          }
        },
        "series_labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "x_label": {
          "type": "string"
        },
        "y_label": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "legend": {
          "type": "boolean"
        },
        "claim": {
          "$ref": "#/$defs/ClaimPosture"
        },
        "type": {
          "const": "chart"
        }
      },
      "additionalProperties": false,
      "required": [
        "chart_type",
        "data",
        "type"
      ]
    },
    "Headline": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "claim": {
          "$ref": "#/$defs/ClaimPosture"
        },
        "type": {
          "const": "headline"
        }
      },
      "additionalProperties": false,
      "required": [
        "text",
        "type"
      ]
    },
    "ClaimCard": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "claim": {
          "$ref": "#/$defs/ClaimPosture"
        },
        "span": {
          "enum": [
            4,
            6,
            8,
            12
          ]
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "readouts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Readout"
          }
        },
        "progress_done": {
          "type": "integer"
        },
        "progress_total": {
          "type": "integer"
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CardAction"
          }
        },
        "tone": {
          "enum": [
            "default",
            "cream",
            "hot",
            "dotted"
          ]
        },
        "type": {
          "const": "claim_card"
        }
      },
      "additionalProperties": false,
      "required": [
        "title",
        "claim",
        "type"
      ]
    },
    "ClaimTimeline": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TimelineEntry"
          }
        },
        "days_before": {
          "type": "integer"
        },
        "days_after": {
          "type": "integer"
        },
        "span": {
          "enum": [
            4,
            6,
            8,
            12
          ]
        },
        "claim": {
          "$ref": "#/$defs/ClaimPosture"
        },
        "type": {
          "const": "claim_timeline"
        }
      },
      "additionalProperties": false,
      "required": [
        "title",
        "entries",
        "type"
      ]
    },
    "EntityFacet": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FacetFact"
          }
        },
        "more": {
          "$ref": "#/$defs/PrimitiveAction"
        },
        "claim": {
          "$ref": "#/$defs/ClaimPosture"
        },
        "type": {
          "const": "entity_facet"
        }
      },
      "additionalProperties": false,
      "required": [
        "title",
        "facts",
        "type"
      ]
    },
    "StatRow": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Stat"
          },
          "minItems": 1,
          "maxItems": 6
        },
        "claim": {
          "$ref": "#/$defs/ClaimPosture"
        },
        "type": {
          "const": "stat_row"
        }
      },
      "additionalProperties": false,
      "required": [
        "items",
        "type"
      ]
    },
    "ClaimList": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ClaimItem"
          }
        },
        "title": {
          "type": "string"
        },
        "claim": {
          "$ref": "#/$defs/ClaimPosture"
        },
        "type": {
          "const": "claim_list"
        }
      },
      "additionalProperties": false,
      "required": [
        "items",
        "type"
      ]
    },
    "Sparkline": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "points": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "maxItems": 60
        },
        "value": {
          "type": "string"
        },
        "claim": {
          "$ref": "#/$defs/ClaimPosture"
        },
        "type": {
          "const": "sparkline"
        }
      },
      "additionalProperties": false,
      "required": [
        "label",
        "points",
        "type"
      ]
    },
    "Card": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Primitive"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Button"
          }
        },
        "body": {
          "type": "string"
        },
        "claim": {
          "$ref": "#/$defs/ClaimPosture"
        },
        "type": {
          "const": "card"
        }
      },
      "additionalProperties": false,
      "required": [
        "title",
        "children",
        "type"
      ]
    },
    "Primitive": {
      "oneOf": [
        {
          "$ref": "#/$defs/Col"
        },
        {
          "$ref": "#/$defs/Row"
        },
        {
          "$ref": "#/$defs/Text"
        },
        {
          "$ref": "#/$defs/Badge"
        },
        {
          "$ref": "#/$defs/Divider"
        },
        {
          "$ref": "#/$defs/Spacer"
        },
        {
          "$ref": "#/$defs/Button"
        },
        {
          "$ref": "#/$defs/Table"
        },
        {
          "$ref": "#/$defs/Form"
        },
        {
          "$ref": "#/$defs/Connections"
        },
        {
          "$ref": "#/$defs/Steps"
        },
        {
          "$ref": "#/$defs/Chart"
        },
        {
          "$ref": "#/$defs/Headline"
        },
        {
          "$ref": "#/$defs/ClaimCard"
        },
        {
          "$ref": "#/$defs/ClaimTimeline"
        },
        {
          "$ref": "#/$defs/EntityFacet"
        },
        {
          "$ref": "#/$defs/StatRow"
        },
        {
          "$ref": "#/$defs/ClaimList"
        },
        {
          "$ref": "#/$defs/Sparkline"
        },
        {
          "$ref": "#/$defs/Card"
        }
      ],
      "discriminator": {
        "propertyName": "type",
        "mapping": {
          "col": "#/$defs/Col",
          "row": "#/$defs/Row",
