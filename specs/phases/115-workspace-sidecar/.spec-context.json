  "approach": "New core/ze-workspace plus sidecar/workspace (browser-helper split). WorkspaceMode is a persisted singleton with in-node interrupt() confirms; skill scripts are stored and need a separate executable approval. In-turn only — detach/follow-through is spec 116.",
  "decisions": [
    {
      "decision": "core/ze-workspace + sidecar/workspace, not a ZePlugin",
      "why": "Cross-cutting computer beside the mind; same split as browser + skills/worldstate wiring",
      "rejected": "Fold into ze-core, or a ZePlugin"
    },
    {
      "decision": "Unprivileged child + stripped env + private-range deny",
      "why": "FR-003/026 without new hypervisor ops",
      "rejected": "gVisor/Firecracker, in-process subprocess, docker.sock sibling box"
    },
    {
      "decision": "WorkspaceMode singleton, not CapabilityGate Mode",
      "why": "Auto-edit and global persistence do not fit per-intent overrides",
      "rejected": "Add AUTO_EDIT to Mode / capability_overrides"
    },
    {
      "decision": "LangGraph interrupt() inside workspace tools for Ask confirms",
      "why": "Per-action Claude Code-like confirm while keeping pending_confirmations",
      "rejected": "Whole-turn CapabilityGate pause, parallel WS auth"
    },
    {
      "decision": "Persist skill scripts; separate approve-executables",
      "why": "114 discarded bytes and instructions-only approve must not silently run scripts",
      "rejected": "Re-fetch origin_url at run time; reuse skill_reference_files"
    },
    {
      "decision": "ToolConfirmationRequired in ze-agents; ingest via DI; output redact; sidecar split",
      "why": "Analyze remediations C1/C2/I1/G1/U1 — no ze-core import of ze-workspace, no plugin import, no ze-ingestion dep",
      "rejected": "WorkspaceConfirmInterrupt in ze_workspace caught by ze_core"
    }
  ],
  "expectations": [
    "Detached runs, wait-then-detach, automatic follow-up turn, and offline push belong to sibling spec 116"
  ],
  "context": [
    "Phase 114 ze-skills (has_unsupported_scripts, discarded script bytes)",
    "sidecar/browser + ze-browser client wiring",
    "CapabilityGate four modes and pending_confirmations",
