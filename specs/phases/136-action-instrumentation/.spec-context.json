  "context": [
    "depends on Phase 135 ActionRecord ledger",
    "instrument workspace, outbound messenger, calendar/reminders, goals/workflows, prospecting outreach",
    "domain stores remain source of truth; ledger cites them",
    "record factual observations after known; exact-one source-derived idempotency",
    "exclude inbound perception, signal_sources rewiring, learning/procedures, arbitration"
  ],
  "approach": "Inject the Phase 135 recorder at each producer terminalization boundary. Record one source-cited immutable ActionRecord per durable producer observation, causally link pending to its terminal observation, and retain producer-domain lifecycle ownership.",
  "decisions": [
    {
      "decision": "Record terminal outcomes after source persistence",
      "why": "An action audit must describe observed results, not intentions",
      "rejected": "Record success at dispatch and append a correction later"
    },
    {
      "decision": "Use source-derived stable idempotency",
      "why": "Retries and callbacks must converge without repeating side effects",
      "rejected": "Deduplicate by callback ID, timestamp, or summary text"
    },
    {
      "decision": "Keep domain records canonical",
      "why": "Recovery and provider lifecycle belong to their producing domain",
      "rejected": "Make ActionRecord a replacement operational store"
    }
  ],
