  "approach": "License Action only for ACTION_RECORD, validate it through Contribution, and append a normalized ze-memory ledger row that cites the existing authoritative domain record.",
  "decisions": [
    {
      "decision": "ActionRecord is a distinct claim kind and payload",
      "why": "Action records execution evidence without treating it as a Fact",
      "rejected": "License Action for FACT or reuse Fact with a marker"
    },
    {
      "decision": "ze-memory owns a thin ledger; source domains stay authoritative",
      "why": "Cross-domain queries need one evidence ledger without duplicate domain truth",
      "rejected": "Per-plugin ledgers or moving source state into ze-memory"
    },
    {
      "decision": "Lifecycle is append-only and idempotency-keyed",
      "why": "At-least-once completion delivery must not duplicate or rewrite evidence",
      "rejected": "A mutable status row or timestamp-based deduplication"
    },
    {
      "decision": "Ledger failures retry delivery, never side effects",
      "why": "A completed source action cannot safely be rerun to repair observability",
      "rejected": "Distributed rollback or automatic action replay"
    }
  ],
