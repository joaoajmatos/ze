  "approach": "Route cancel speech to existing domain tools; no dual-write forget_fact; 143 claims stay",
  "decisions": [
    {
      "decision": "Extractor classifies cancel/drop/abandon of reminder/loop/goal as those acts, not forget; companion delegates to owning agents",
      "why": "142 prompt and R14 table still leave forget the dentist as biography forget",
      "rejected": "Prompt-only companion paragraph; graph-router all forget-* to reminders"
    },
    {
      "decision": "One primary domain write per cancel speech act; never fall back to forget_fact",
      "why": "Principle VIII forbids a just-in-case biography retract after domain cancel",
      "rejected": "Try forget_fact after a domain miss"
    },
    {
      "decision": "Add a loops agent wrapping existing close_loop/drop_loop; companion does not own those tools",
      "why": "Loops are REST-only today; US1 requires a conversational close path without a fourth store",
      "rejected": "Inject LoopStore into CompanionAgent; skip loops this phase"
    },
    {
      "decision": "Hard-cut delegate result to {response, tool_calls} so honesty can earn domain cancel from nested payloads",
      "why": "Delegate currently returns only specialist text; success is not cancel success",
      "rejected": "Treat delegate_to_agent success as earned cancel; put cancel_reminder on companion"
    },
    {
      "decision": "Forgotten-fact claims stay 143 forget_fact ok; add domain-claim strip for cancel/close/abandon wording",
      "why": "FR-004 and FR-005 are different licenses",
      "rejected": "Treat domain cancel success as earned forget"
    },
    {
      "decision": "precise_label_match unique/miss/ambiguous before at most one write; no batch substring cancel",
      "why": "Short token dentist must not cancel every dentist reminder",
      "rejected": "Query ILIKE on cancel_reminder; reuse _retract_facts_matching"
    }
  ],
